{
  "name": "libbetterscad",
  "version": "0.33.3",
  "description": "A complete OpenSCAD engine for JavaScript: parse, validate and render any .scad file to meshes, read its Customizer parameters, and export STL, 3MF, OFF, AMF, SVG and DXF. Runs in Node, Web Workers and the browser. No DOM, no UI.",
  "keywords": [
    "openscad",
    "scad",
    "openscad-compatible",
    "customizer",
    "cad",
    "parametric",
    "csg",
    "manifold",
    "stl",
    "3mf",
    "3d printing",
    "geometry",
    "webassembly"
  ],
  "license": "MIT",
  "author": "Anam Ahmed <anam.ahmed.a@gmail.com>",
  "homepage": "https://betterscad.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theanam/betterScad.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/theanam/betterScad/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "manifold-3d": "^3.0.1",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/opentype.js": "^1.3.8"
  }
}
