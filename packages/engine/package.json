{
  "name": "libbetterscad",
  "version": "0.33.4",
  "description": "The BetterSCAD engine: a complete OpenSCAD implementation plus BetterSCAD's extensions (rounded cube(r), negative(), thread(), gear(), get_size() and more) and .bscad files. Parse, validate and render to meshes, read Customizer parameters, export STL, 3MF, OFF, AMF, SVG and DXF, and write plain OpenSCAD back out. Node, Web Workers and the browser. No DOM, no UI.",
  "keywords": [
    "openscad",
    "scad",
    "openscad-compatible",
    "betterscad",
    "bscad",
    "customizer",
    "cad",
    "parametric",
    "csg",
    "manifold",
    "stl",
    "3mf",
    "3d printing",
    "geometry",
    "webassembly"
  ],
  "license": "MIT",
  "author": "Anam Ahmed <anam.ahmed.a@gmail.com>",
  "homepage": "https://betterscad.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theanam/betterScad.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/theanam/betterScad/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "manifold-3d": "^3.0.1",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/opentype.js": "^1.3.8"
  }
}
